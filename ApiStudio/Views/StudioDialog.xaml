<UserControl x:Class="ApiStudio.StudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="480" FontFamily="Microsoft YaHei UI" FontSize="13"
        FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <UserControl.Resources><ResourceDictionary Source="../Themes/StudioStyles.xaml"/></UserControl.Resources>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10">
        <Grid x:Name="DialogRoot">
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Thumb x:Name="DialogDragHandle" Focusable="False" IsTabStop="False" Cursor="SizeAll"
                       DragDelta="DialogDragDelta" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                       AutomationProperties.Name="拖动对话框">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                </Thumb>
                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" IsHitTestVisible="False">
                    <Image Source="../Assets/ApiStudio.png" Width="19" Height="19" Margin="0,0,8,0"/>
                    <TextBlock Text="API Studio" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
                <Button x:Name="DialogCloseButton" HorizontalAlignment="Right" Width="34" Height="32" Margin="0,0,7,0"
                        Style="{StaticResource WindowCloseButton}" ToolTip="关闭" AutomationProperties.Name="关闭对话框"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M1,1 L10,10 M10,1 L1,10" Width="11" Height="11" StrokeThickness="1.2"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="26,9,26,24">
                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="DialogIconBadge" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Hover}" Margin="0,0,13,0">
                        <Path x:Name="DialogIcon" Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                              Stroke="{DynamicResource Accent}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M9,1 A8,8 0 1 0 9,17 A8,8 0 1 0 9,1 M9,5 L9,10 M9,13 L9,13.2"/>
                    </Border>
                    <TextBlock x:Name="DialogTitle" Grid.Column="1" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
                <ContentControl x:Name="DialogBody" HorizontalContentAlignment="Stretch"/>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="26,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DialogCancelButton" Content="取消" MinWidth="88" Height="35"/>
                    <Button x:Name="DialogConfirmButton" Content="确定" MinWidth="88" Height="35" Margin="9,0,0,0"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
