<Window x:Class="ApiStudio.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="API Studio · 接口调试工作台" Icon="../Assets/ApiStudio.png"
        Width="1440" Height="940" MinWidth="1140" MinHeight="800"
        WindowState="Maximized" WindowStartupLocation="CenterScreen" WindowStyle="None"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary Source="../Themes/StudioStyles.xaml"/>
    </Window.Resources>
    <Border x:Name="WindowFrame" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="TitleBar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
            <Grid Margin="16,0,6,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeButton" Width="50" Style="{StaticResource WindowControlButton}" AutomationProperties.Name="界面主题" Click="ThemeClick" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ThemeIcon" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.3"
                                  Stroke="{DynamicResource Ink}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform x:Name="ThemeRotation"/></Path.RenderTransform></Path>
                            <Path Margin="6,0,0,0" Data="M0,0 L3,3 L6,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="16" Background="{DynamicResource Border}" Margin="0,0,9,0"/>
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButton}" Click="MinimizeClick" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <Path Data="M0,5 L10,5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Click="MaximizeClick" ToolTip="最大化" AutomationProperties.Name="最大化">
                        <Path x:Name="MaximizeIcon" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/>
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButton}" Click="CloseWindowClick" ToolTip="关闭" AutomationProperties.Name="关闭窗口">
                        <Path Data="M1,1 L10,10 M10,1 L1,10" Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    <Grid x:Name="WorkspaceGrid" Grid.Row="1" Background="{DynamicResource Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="336" MinWidth="280"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="640"/>
        </Grid.ColumnDefinitions>

        <Grid Background="{DynamicResource Rail}" TextElement.Foreground="{DynamicResource RailText}">
            <Grid Margin="16,14,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Assets/ApiStudio.png" Width="44" Height="44" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="API Studio" Foreground="{DynamicResource RailText}" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <DockPanel Grid.Row="1" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="＋ 文件夹" Click="AddFolderClick" Style="{StaticResource RailButton}"
                            VerticalAlignment="Center" MinHeight="30"/>
                    <TextBlock Text="接口集合" FontSize="14" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBox x:Name="SearchBox" Grid.Row="2" AutomationProperties.Name="搜索接口或地址" TextChanged="SearchChanged"
                         Background="{DynamicResource RailSurface}" BorderBrush="{DynamicResource RailStroke}" Foreground="{DynamicResource RailText}"/>
                <TextBlock Grid.Row="3" Text="搜索接口或地址" FontSize="11" Foreground="{DynamicResource RailMuted}"/>
                <TreeView x:Name="CollectionTree" Grid.Row="4" Margin="0,0,0,7" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource RailText}" HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectedItemChanged="TreeSelectionChanged" PreviewMouseRightButtonDown="TreeRightClick"
                          PreviewMouseLeftButtonDown="TreeMouseDown" PreviewMouseMove="TreeMouseMove"
                          AllowDrop="True" DragOver="TreeDragOver" DragLeave="TreeDragLeave" Drop="TreeDrop">
                    <TreeView.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource StudioScrollViewer}"/></TreeView.Resources>
                </TreeView>
                <Button Grid.Row="5" Content="＋  新建接口" Margin="0,4" Click="AddRequestClick" Style="{StaticResource RailButton}"/>
                <TextBlock x:Name="CollectionCount" Grid.Row="6" FontSize="11" Foreground="{DynamicResource RailMuted}"/>
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="导入目录" Click="ImportClick" Style="{StaticResource RailButton}"/>
                    <Button Grid.Column="2" Content="导出集合" Click="ExportClick" Style="{StaticResource RailButton}"/>
                </Grid>
            </Grid>
        </Grid>
        <GridSplitter x:Name="SidebarDivider" Grid.Column="1" Style="{StaticResource Divider}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="调整侧栏宽度"/>

        <Grid Grid.Column="2" Margin="18,0,24,0">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="33"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="接口工作台" FontSize="25" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
                <Border x:Name="EmptyPage" Style="{StaticResource Card}" MaxWidth="560" Height="280" VerticalAlignment="Center" Padding="30">
                    <StackPanel VerticalAlignment="Center">
                        <Image Source="../Assets/ApiStudio.png" Width="48" Height="48" Margin="0,0,0,13"/>
                        <TextBlock Text="开始调试你的第一个接口" FontWeight="SemiBold" FontSize="22" TextAlignment="Center"/>
                        <TextBlock Text="新建一个接口，或导入已保存的接口目录。" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,7,0,18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="＋  新建接口" Width="150" Click="AddRequestClick" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="导入目录" Width="150" Click="ImportClick" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid x:Name="EditorPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="15,10,15,14" Margin="0,0,0,13">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="41"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBox x:Name="RequestTitle" AutomationProperties.Name="接口名称（可直接修改）"
                                             FontSize="16" FontWeight="SemiBold" MaxLength="80"
                                             Background="Transparent" BorderThickness="0" Padding="0,0,0,1"
                                             TextChanged="TitleChanged" LostKeyboardFocus="TitleLostFocus" KeyDown="TitleKeyDown"/>
                                    <TextBlock x:Name="Breadcrumb" FontSize="12" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <DockPanel Grid.Column="1" Margin="0,0,11,0" VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Text="状态" Style="{StaticResource MutedText}" Margin="0,0,9,0"/>
                                    <ComboBox x:Name="RequestStatus" AutomationProperties.Name="接口状态" SelectionChanged="StatusChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#3B82F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="测试中"><Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="调试中"><Setter Property="Fill" Value="#A855F7"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="已完成"><Setter Property="Fill" Value="#10B981"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                                <Button Grid.Column="2" Content="保存  Ctrl+S" Click="SaveClick" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition/><ColumnDefinition Width="105"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="RequestMethod" AutomationProperties.Name="请求方法" FontWeight="SemiBold" SelectionChanged="MethodChanged"/>
                                <TextBox x:Name="AddressBox" Grid.Column="1" AutomationProperties.Name="请求地址"
                                         Margin="8,0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="15" TextChanged="AddressChanged"/>
                                <Button x:Name="SendButton" Grid.Column="2" Content="发送  ↗" Click="SendClick" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                                <Button x:Name="CancelButton" Grid.Column="3" Content="取消" IsEnabled="False" Click="CancelClick"/>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="调用方式" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="RequestType" Grid.Column="1" AutomationProperties.Name="调用方式" SelectionChanged="RequestTypeChanged"/>
                                <TextBlock x:Name="SoapActionHint" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" AutomationProperties.Name="自动生成的 Action"
                                           ToolTip="SOAP 请求头中的 SOAPAction，用于告诉服务调用哪个方法。由「命名空间 + 方法名」自动生成，无需手动填写。"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid x:Name="PayloadGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RequestRow" Height="255" MinHeight="180"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition x:Name="ResponseRow" Height="*" MinHeight="200"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <TabControl x:Name="RequestTabs" SelectionChanged="RequestTabChanged">
                                    <TabItem Header="请求体">
                                        <Grid>
                                            <!-- API 模式：原始 JSON / 文本请求体 -->
                                            <DockPanel x:Name="JsonBodyPanel">
                                                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Subtle}" Padding="15,5">
                                                    <TextBlock x:Name="BodyHint" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <ContentControl x:Name="RequestHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                                            </DockPanel>
                                            <!-- WebService 模式：表格化入参 -->
                                            <Grid x:Name="WsBodyPanel" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Margin="14,10,14,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="方法名" VerticalAlignment="Center" Margin="0,0,9,0" FontWeight="SemiBold"/>
                                                    <TextBox x:Name="WsMethodBox" Grid.Column="1" AutomationProperties.Name="WebService 方法名"
                                                             ToolTip="自动取自地址中的 ?op=（如 .../Service.asmx?op=GetBoxInfo），也可手动修改；改后 Action 自动更新。"/>
                                                    <TextBlock Grid.Column="3" Text="命名空间" VerticalAlignment="Center" Margin="0,0,9,0" FontWeight="SemiBold"/>
                                                    <TextBox x:Name="WsNamespaceBox" Grid.Column="4" AutomationProperties.Name="WebService 命名空间"
                                                             ToolTip="方法元素的默认命名空间，默认 http://tempuri.org/；与服务 WSDL 的 targetNamespace 不一致时改成对应值，Action 会自动更新。"/>
                                                </Grid>
                                                <ScrollViewer Grid.Row="1" Style="{StaticResource StudioScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,0,14,0">
                                                    <StackPanel>
                                                        <Grid Height="30" Background="{DynamicResource Subtle}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42"/>
                                                                <ColumnDefinition Width="210"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="54"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"/>
                                                            <TextBlock Text="#" Margin="10,0,0,0" FontSize="11"/>
                                                            <TextBlock Grid.Column="1" Text="入参名称" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="2" Text="入参值" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="3" Text="操作" FontSize="11"/>
                                                        </Grid>
                                                        <StackPanel x:Name="WsRows"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                                <DockPanel Grid.Row="2" Margin="14,6,14,9">
                                                    <TextBlock x:Name="WsHint" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Text="每行一个入参：填写参数名称与参数值，发送时自动拼成 SOAP 报文。" Margin="0,0,10,0"/>
                                                    <Button DockPanel.Dock="Right" Content="＋ 添加入参" Click="AddWsRowClick" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="请求头">
                                        <TextBox x:Name="RequestHeaders" Style="{StaticResource PlainEditor}" TextChanged="HeadersChanged" AutomationProperties.Name="请求头"/>
                                    </TabItem>
                                    <TabItem Header="Query 参数">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,9">
                                                <TextBlock Text="每行一个 key=value，应用后自动进行 URL 编码。" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                                <Button Content="应用到地址" HorizontalAlignment="Left" Click="ApplyQueryClick"/>
                                            </StackPanel>
                                            <TextBox x:Name="QueryBox" Style="{StaticResource PlainEditor}" AutomationProperties.Name="Query 参数"/>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                                <StackPanel x:Name="BodyFormatActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,9,0">
                                    <Button Content="压缩" Click="CompactRequestClick"/>
                                    <Button x:Name="FormatRequestButton" Content="格式化 JSON" Click="FormatRequestClick" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <GridSplitter x:Name="PayloadDivider" Grid.Row="1" Style="{StaticResource Divider}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      AutomationProperties.Name="调整请求与响应区高度"/>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="15,7,15,0" Height="31">
                                    <TextBlock DockPanel.Dock="Left" Text="响应结果" FontWeight="SemiBold" FontSize="14" Margin="0,0,14,0"/>
                                    <TextBlock x:Name="ResponseInfo" DockPanel.Dock="Left" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ResponseMeta" Style="{StaticResource MutedText}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid>
                                    <TabControl x:Name="ResponseTabs">
                                        <TabItem Header="响应体"><ContentControl x:Name="ResponseHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></TabItem>
                                        <TabItem Header="响应头">
                                            <TextBox x:Name="ResponseHeaders" Style="{StaticResource PlainEditor}" IsReadOnly="True" AutomationProperties.Name="响应头"/>
                                        </TabItem>
                                    </TabControl>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,9,0">
                                        <Button Content="另存为" Click="SaveResponseClick"/>
                                        <Button Content="复制" Click="CopyResponseClick" Margin="6,0"/>
                                        <Button x:Name="FormatResponseButton" Content="格式化 JSON" Click="FormatResponseClick"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Right" Text="API Studio  /  WPF" Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0"/>
                <TextBlock x:Name="Footer" Text="就绪  ·  Ctrl + Enter 发送请求  /  Ctrl + S 保存" Style="{StaticResource MutedText}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Grid>
        <Grid x:Name="DialogShade" Grid.RowSpan="2" Background="#66070F1B" Visibility="Collapsed"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
    </Border>
</Window>
